{
  "name": "Smart AI Translator (Brand-Safe)",
  "description": "Translate with AI models while preserving brand names and style.",
  "version": "1.1.1",
  "manifest_version": 3,

  "action": {
    "default_title": "AI Translate",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "options.html",

  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.mistral.ai/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}